{
  "name": "create-voshod",
  "version": "0.4.1",
  "description": "Vite-based CLI tool for scaffolding single-page applications.",
  "keywords": [
    "vite",
    "react",
    "cli",
    "scaffold",
    "create"
  ],
  "homepage": "https://github.com/ayysoawesome/create-voshod#readme",
  "bugs": {
    "url": "https://github.com/ayysoawesome/create-voshod/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayysoawesome/create-voshod.git"
  },
  "author": "ayyso <ayysoawesome@yandex.ru>",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "create-voshod": "bin/index.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --dts --clean --out-dir dist",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test && npm run build",
    "test": "tsx --test src/**/*.test.ts",
    "test:cli:smoke": "tsx scripts/cli-smoke.ts",
    "test:cli:matrix": "tsx scripts/cli-combination-matrix.ts",
    "test:cli:play": "tsx scripts/cli-playground.ts",
    "test:cli:play:full": "tsx scripts/cli-playground.ts --full"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "execa": "^8.0.0",
    "fs-extra": "^11.1.1",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.8.1",
    "prompts": "^2.4.2",
    "ts-morph": "^27.0.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.6.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2"
  }
}
